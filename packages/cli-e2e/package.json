{
  "name": "@coveo/cli-e2e",
  "private": true,
  "version": "1.25.0",
  "description": "End-to-End test of Coveo's CLI",
  "author": "Coveo",
  "homepage": "https://github.com/coveo/cli#readme",
  "license": "Apache-2.0",
  "directories": {
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coveo/cli.git"
  },
  "scripts": {
    "lint": "eslint .",
    "test-e2e": "npm run test:headless",
    "test:headless": "node ./entrypoints/entry.js",
    "test:debug": "node ./entrypoints/entry.js --debug",
    "test:bash": "node ./entrypoints/entry.js --bash",
    "jest": "npm run jest:ci",
    "jest:ci": "jest --verbose --runInBand --detectOpenHandles --forceExit",
    "prejest": "rimraf artifacts ui-projects verdaccio/verdaccio",
    "jest:debug": "node --inspect-brk ../../node_modules/jest/bin/jest.js --runInBand",
    "verdaccio": "verdaccio --config ./verdaccio/config.yaml"
  },
  "bugs": {
    "url": "https://github.com/coveo/cli/issues"
  },
  "engines": {
    "node": "^18.18.1 || ^20.9.0 || ^22.0.0 || ^24.0.0"
  },
  "devDependencies": {
    "@actions/core": "3.0.0",
    "@types/async-retry": "1.4.9",
    "@types/folder-hash": "4.0.4",
    "@types/fs-extra": "11.0.4",
    "@types/is-running": "2.1.2",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@types/tmp": "0.2.6",
    "@types/wait-on": "5.3.4",
    "chrome-launcher": "1.2.1",
    "eslint": "10.2.0",
    "fkill": "10.0.3",
    "folder-hash": "4.1.2",
    "is-running": "2.1.0",
    "open": "11.0.0",
    "pacote": "21.5.0",
    "tmp": "0.2.5",
    "ts-node": "10.9.2",
    "verdaccio": "6.5.0",
    "wait-on": "9.0.5"
  },
  "dependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-typescript": "7.28.5",
    "@coveo/cli": "3.2.14",
    "@coveo/platform-client": "65.0.0",
    "abortcontroller-polyfill": "1.7.8",
    "async-retry": "1.3.3",
    "babel-jest": "30.3.0",
    "devtools-protocol": "0.0.1612613",
    "dotenv": "17.4.2",
    "fs-extra": "11.3.4",
    "get-port": "7.2.0",
    "isomorphic-fetch": "3.0.0",
    "jest": "30.3.0",
    "puppeteer": "24.40.0",
    "strip-ansi": "7.2.0",
    "typescript": "6.0.2"
  }
}
