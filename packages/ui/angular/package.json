{
  "name": "@coveo/angular",
  "version": "1.36.16",
  "description": "Coveo schematic for angular",
  "scripts": {
    "test": "jest",
    "test:ci:snap": "jest -u",
    "lint": "prettier --check . && eslint .",
    "build": "tsc -p tsconfig.schematic.json",
    "prebuild": "node ./scripts/clean.js",
    "postbuild": "node ./scripts/setup.js",
    "prepublishOnly": "npm run build",
    "release:phase1": "npx -p=@coveord/release npm-publish"
  },
  "keywords": [
    "schematics",
    "coveo",
    "headless",
    "angular"
  ],
  "author": "Coveo",
  "main": "index.js",
  "license": "Apache-2.0",
  "schematics": "./dist/collection.json",
  "dependencies": {
    "@angular-devkit/core": "^21.2.7",
    "@angular-devkit/schematics": "^21.2.7",
    "@angular/cdk": "^21.2.6",
    "@angular/cli": "^21.2.7",
    "@coveo/search-token-server": "1.37.6",
    "@schematics/angular": "^21.2.7",
    "jest-config": "30.3.0"
  },
  "devDependencies": {
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/material": "^21.2.6",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@coveo/headless": "latest",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "fs-extra": "11.3.4",
    "jest": "30.3.0",
    "prettier": "3.8.2",
    "ts-jest": "29.4.9",
    "typescript": "6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
