{
  "name": "@coveo/cli-commons",
  "version": "2.9.11",
  "author": "Coveo",
  "description": "Common utils for @coveo/cli plugins",
  "license": "Apache-2.0",
  "files": [
    "lib/**"
  ],
  "exports": {
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "devDependencies": {
    "@coveo/cli-commons-dev": "6.0.6",
    "@types/is-ci": "3.0.4",
    "@types/jest": "30.0.0",
    "@types/npm-package-arg": "6.1.4",
    "jest": "30.3.0",
    "jsonschema": "1.5.0",
    "ts-jest": "29.4.9",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@amplitude/analytics-node": "^1.5.53",
    "@amplitude/analytics-types": "^2.11.1",
    "@coveo/platform-client": "65.0.0",
    "@oclif/core": "4.10.5",
    "abortcontroller-polyfill": "1.7.8",
    "chalk": "5.6.2",
    "fs-extra": "11.3.4",
    "https-proxy-agent": "9.0.0",
    "is-ci": "4.1.0",
    "isomorphic-fetch": "3.0.0",
    "npm-package-arg": "13.0.2",
    "semver": "7.7.4",
    "ts-dedent": "2.2.0"
  },
  "scripts": {
    "test": "jest",
    "test:ci:snap": "jest -u",
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "release:phase1": "npx -p=@coveord/release npm-publish"
