{
  "name": "@coveo/cli-plugin-source",
  "version": "2.3.11",
  "description": "Manage Coveo Sources with the Coveo CLI",
  "author": "Coveo",
  "homepage": "https://github.com/coveo/cli",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "repository": "coveo/cli",
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@coveo/cli-commons": "2.9.11",
    "@coveo/platform-client": "65.0.0",
    "@coveo/push-api-client": "4.0.24",
    "@oclif/core": "4.10.5",
    "@oclif/plugin-help": "6.2.44",
    "@oclif/plugin-plugins": "5.4.61",
    "chalk": "5.6.2",
    "jsonschema": "1.5.0",
    "ts-dedent": "2.2.0"
  },
  "devDependencies": {
    "@coveo/cli-commons-dev": "6.0.6",
    "@coveo/semantic-monorepo-tools": "2.7.1",
    "@oclif/test": "4.1.18",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "jest": "30.3.0",
    "oclif": "4.23.0",
    "stdout-stderr": "0.1.13",
    "strip-ansi": "7.2.0",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "undici": "8.1.0"
  },
  "oclif": {
    "bin": "coveo",
    "dirname": "coveo",
    "repositoryPrefix": "<%- repo %>/blob/v<%- version %>/packages/cli/source/<%- commandPath %>",
    "description": "Coveo CLI - Source Plugin",
    "commands": "./lib/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": ":",
    "topics": {
      "source": {
        "description": "manage Coveo sources"
      },
      "source:push": {
        "description": "manage Coveo Push API sources"
      },
      "source:catalog": {
        "description": "manage Coveo Catalog sources"
      }
    }
  },
  "scripts": {
    "build": "rimraf lib && tsc -b tsconfig.build.json --force",
    "pretest": "npm run build",
    "test": "jest --colors",
    "test:ci:snap": "jest --colors -u",
    "lint": "prettier --config .prettierrc.js --check . && eslint .",
    "release:phase1": "npx -p=@coveord/release npm-publish",
    "postpack": "rimraf oclif.manifest.json",
    "prepublishOnly": "rimraf lib && npm run build && oclif manifest"
  },
  "engines": {
    "node": "^18.18.1 || ^20.9.0 || ^22.0.0 || ^24.0.0"
  },
  "bugs": "https://github.com/coveo/cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
