{
  "compilerOptions": {
    "outDir": "dist",
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "dist",
    "lib": ["ESNext"],
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "target": "ESNext",
    "sourceMap": true,
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["src"]
}
